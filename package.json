{
  "name": "Schedule Discussion Post Action",
  "description": "This action will create a discussion post in a repository at a scheduled time.",
  "version": "0.0.0",
  "author": "Ben Balter",
  "private": true,
  "homepage": "https://github.com/benbalter/schedule-discussion-posts-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benbalter/schedule-discussion-posts-action.git"
  },
  "bugs": {
    "url": "https://github.com/benbalter/schedule-discussion-posts-action/issues"
  },
  "keywords": [
    "actions",
    "discussions",
    "cron",
    "schedule"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "npx jest",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "package": "npx ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package:watch": "npm run package -- --watch",
    "test": "npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package",
    "cron": "node --env-file-if-exists=.env --import tsx src/index.ts"
  },
  "license": "MIT",
  "jest": {
    "preset": "ts-jest",
    "verbose": true,
    "clearMocks": true,
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/setup.ts"
    ]
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "chrono-node": "^2.7.6",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "24.19.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-prettier": "5.5.6",
    "fetch-mock": "^10.0.7",
    "globals": "17.12.0",
    "jest": "^30.0.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "typescript-eslint": "8.70.1"
  }
}
